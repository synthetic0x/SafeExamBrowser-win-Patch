diff --git a/SafeExamBrowser.Client/Operations/WindowGuardOperation.cs b/SafeExamBrowser.Client/Operations/WindowGuardOperation.cs
index cb0b944d..9e59656f 100644
--- a/SafeExamBrowser.Client/Operations/WindowGuardOperation.cs
